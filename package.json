{
  "name": "trinno-research",
  "displayName": "Trinno Research Assist",
  "description": "Research assistant with AI-powered chat for Jupyter notebooks",
  "version": "1.4.10",
  "publisher": "Open1s",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/open1s/trinno.git"
  },
  "homepage": "https://github.com/open1s/trinno#readme",
  "bugs": {
    "url": "https://github.com/open1s/trinno/issues"
  },
  "keywords": [
    "triz",
    "research",
    "jupyter",
    "ai-assistant",
    "paper-download",
    "patent",
    "innovation",
    "notebook"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook",
    "onCommand:trinno-chat.open",
    "onCommand:trinno-chat.undoInsert",
    "onCommand:trinno-chat.clearHistory"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trinno-chat.open",
        "title": "Open Research Assistant",
        "category": "Trinno Chat"
      },
      {
        "command": "trinno-chat.undoInsert",
        "title": "Undo Last AI Insert",
        "category": "Trinno Chat"
      },
      {
        "command": "trinno-chat.clearHistory",
        "title": "Clear Chat History",
        "category": "Trinno Chat"
      },
      {
        "command": "trinno-chat.sendContext",
        "title": "Send to Trinno Chat",
        "category": "Trinno Chat"
      },
      {
        "command": "trinno-chat.sendFile",
        "title": "Send File to Trinno Chat",
        "category": "Trinno Chat"
      }
    ],
    "menus": {
      "notebook/cell/context": [
        {
          "command": "trinno-chat.sendContext",
          "group": "navigation"
        },
        {
          "command": "trinno-chat.sendFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "trinno-chat.sendContext",
          "when": "activeEditor != null || activeNotebookEditor != null"
        },
        {
          "command": "trinno-chat.sendFile",
          "when": "activeEditor != null || activeNotebookEditor != null"
        }
      ],
      "editor/context": [
        {
          "command": "trinno-chat.sendContext",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "trinno-chat.sendFile",
          "when": "activeEditor != null",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trinno-chat-container",
          "title": "Research Assistant",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "trinno-chat-container": [
        {
          "type": "webview",
          "id": "trinno.chatView",
          "name": "Research Assistant"
        }
      ]
    },
    "keybindings": [
      {
        "command": "trinno-chat.open",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus || !editorTextFocus"
      }
    ],
    "configuration": [
      {
        "title": "Trinno",
        "properties": {
        "chat.trinno.global_model": {
          "type": "object",
          "default": { "model": "", "base_url": "", "api_key": "" },
          "properties": {
            "model": { "type": "string", "default": "" },
            "base_url": { "type": "string", "default": "" },
            "api_key": { "type": "string", "default": "" }
          },
          "description": "Default LLM model configuration (from TOML [global_model])"
        },
        "chat.trinno.active_llm": {
          "type": "string",
          "default": "",
          "description": "Key of the active named LLM profile from [llm.*]. Empty = use global_model"
        },
        "chat.trinno.llm": {
          "type": "object",
          "default": {},
          "description": "Named LLM profiles (from TOML [llm.*]). Each key is a profile name with model/base_url/api_key fields."
        },
        "chat.trinno.persona": {
          "type": "object",
          "default": { "name": "Research Assistant", "prompt": "" },
          "properties": {
            "name": { "type": "string", "default": "Research Assistant" },
            "prompt": { "type": "string", "default": "" }
          },
          "description": "Agent persona configuration"
        },
        "chat.trinno.streaming": {
          "type": "object",
          "default": { "show_thinking": true, "thinking_flush_interval": 200 },
          "properties": {
            "show_thinking": { "type": "boolean", "default": true },
            "thinking_flush_interval": { "type": "number", "default": 200 }
          },
          "description": "Response streaming settings"
        },
        "chat.trinno.context": {
          "type": "object",
          "default": { "auto_inject": true, "max_chars_per_cell": 500, "max_total_tokens": 4000, "max_chars_per_attachment": 2000 },
          "properties": {
            "auto_inject": { "type": "boolean", "default": true },
            "max_chars_per_cell": { "type": "number", "default": 500 },
            "max_total_tokens": { "type": "number", "default": 4000 },
            "max_chars_per_attachment": { "type": "number", "default": 2000 }
          },
          "description": "Notebook context extraction settings"
        },
        "chat.trinno.history": {
          "type": "object",
          "default": { "enabled": true, "max_messages": 100 },
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "max_messages": { "type": "number", "default": 100 }
          },
          "description": "Chat history persistence settings"
        },
        "chat.trinno.tools": {
          "type": "object",
          "default": { "permissions": {} },
          "properties": {
            "permissions": {
              "type": "object",
              "default": {},
              "description": "Tool permission configuration. Values: \"allow\" (auto-execute), \"deny\" (blocked), \"ask\" (requires approval)"
            }
          },
          "description": "Tool permission settings"
        },
        "chat.trinno.sandbox": {
          "type": "object",
          "default": { "enabled": true },
          "properties": {
            "enabled": { "type": "boolean", "default": true }
          },
          "description": "Terminal sandbox settings"
        },
        "chat.trinno.mcp": {
          "type": "object",
          "default": { "servers": [] },
          "properties": {
            "servers": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "enum": ["stdio", "http"] },
                  "command": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" } },
                  "url": { "type": "string" }
                }
              },
              "description": "MCP servers to connect"
            }
          },
          "description": "MCP server configuration"
        },
        "chat.trinno.papers": {
          "type": "object",
          "default": { "output_dir": "", "unpaywall_email": "trinno-research@example.com" },
          "properties": {
            "output_dir": { "type": "string", "default": "" },
            "unpaywall_email": { "type": "string", "default": "trinno-research@example.com" }
          },
          "description": "Paper download settings"
        },
        "chat.trinno.agent": {
          "type": "object",
          "default": { "max_iterations": 100, "timeout_seconds": 30 },
          "properties": {
            "max_iterations": { "type": "number", "default": 100 },
            "timeout_seconds": { "type": "number", "default": 30 }
          },
          "description": "Agent runtime limits (from TOML [agent])"
        },
        "chat.trinno.logging": {
          "type": "object",
          "default": { "level": "trace", "console": false },
          "properties": {
            "level": { "type": "string", "default": "trace" },
            "console": { "type": "boolean", "default": false }
          },
          "description": "Logging configuration (from TOML [logging])"
        },
        "chat.trinno.tavily": {
          "type": "object",
          "default": { "api_key": "" },
          "properties": {
            "api_key": { "type": "string", "default": "" }
          },
          "description": "Tavily web search API (from TOML [tavily])"
        },
        "chat.trinno.bus": {
          "type": "object",
          "default": { "max_queue_size": 1000 },
          "properties": {
            "max_queue_size": { "type": "number", "default": 1000 }
          },
          "description": "Event bus settings (from TOML [bus])"
        },
        "chat.trinno.skills_registry": {
          "type": "object",
          "default": { "skills": [] },
          "properties": {
            "skills": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "repo": { "type": "string" },
                  "ref": { "type": "string" },
                  "tags": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "description": "Remote skills registry (from TOML [skills_registry])"
        }
      }
    }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "rm -rf dist/test && tsc -p ./ && rm -rf dist/chat/webview && cp -r src/chat/webview dist/chat/webview",
    "watch": "tsc -watch -p ./",
    "test": "node ./dist/test/runTest.js",
    "test:pipeline": "npx --yes mocha --ui bdd --timeout 30000 \"dist/test/suite/publication-trends-year-extraction.test.js\"",
    "lint": "eslint src/chat/*.ts",
    "cold-start": "bash scripts/verify-cold-start.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/global-agent": "^3.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.120.0",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "glob": "^13.0.6",
    "mocha": "^8.1.3",
    "tslib": "^2.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vscode-languageclient": "^10.0.0"
  },
  "dependencies": {
    "@open1s/ezbos": "^1.3.8",
    "@vscode/jupyter-extension": "^1.1.1",
    "global-agent": "^4.1.3",
    "i18next": "^26.3.1",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "pino": "^10.3.1",
    "toml": "^4.3.0",
    "undici": "^8.5.0"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}